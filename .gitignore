# Large or rebuildable artifacts: never committed.
#   datasets / indexes -> downloaded from their sources (src.download, src.datasets.sources)
#   caches             -> rebuilt by src.pipeline
#   frozen GATs        -> Hugging Face Hub (src.hub, configs/hub.yaml)
data/
cache/
cache_smoke/
results_smoke/
results_regression/
results_smoke_regression/
results/runs/
*.pt
*.safetensors

# logs/ is committed; stray SLURM output in the repo root is not
slurm-*.out

__pycache__/
*.pyc
.pytest_cache/
paper/*.log
paper/*.blg
paper/*.aux
paper/*.out
